# Node 24+, one server process. Never commit the live data or secrets.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/bytmarket.sqlite
BACKUP_DIR=backups
DEMO_MODE=0
SECURE_COOKIES=0
# For LAN/public operation put behind TLS and explicitly configure trusted origin.
# No cash-register or 1C credentials are needed for internal accounting.
